# =============================================================================
# Security
# =============================================================================
.env
.env.*

# =============================================================================
# Data
# =============================================================================
# data/raw/ is huge (~600 MB) and fully regenerable by src/downloader.py.
data/raw/

# Intermediate "MASTER_*" artefacts produced by steps 2 and 3 of the pipeline.
# They are regenerated on every cron run from data/raw/, and the largest of
# them (MASTER_PI_History.csv) exceeds GitHub's 100 MB per-file limit on the
# free tier. The Shiny app does not read them directly, so they are excluded.
data/processed/MASTER_PI_History.csv
data/processed/MASTER_NIH_Projects.csv

# Intermediate plots regenerated by descriptive_stats.R when needed.
data/processed/plots/

# Raw-data archives staged for upload as GitHub Release assets (the cron
# downloads them from the Release URL, never from git).
nih_raw.tar.gz
nih_raw.tar.xz
*.tar.gz
*.tar.xz

# =============================================================================
# Python
# =============================================================================
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo

