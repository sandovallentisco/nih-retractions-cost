# 1. DESCARGAR INFLACIÓN OFICIAL (EEUU) Y CREAR DEFLACTOR
# ------------------------------------------------------------------------------
cat("Descargando datos históricos de inflación (CPI) desde la Reserva Federal...\n")
getSymbols("CPIAUCSL", src='FRED') # Índice de precios al consumidor EEUU
df_cpi <- data.frame(Date = index(CPIAUCSL), CPI = coredata(CPIAUCSL))
colnames(df_cpi) <- c("Date", "CPI")
cpi_anual <- df_cpi %>%
mutate(Fiscal_Year = year(Date)) %>%
group_by(Fiscal_Year) %>%
summarise(CPI = mean(CPI, na.rm = TRUE))
shiny::runApp()
runApp()
shiny::runApp()
