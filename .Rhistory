scale_x_continuous(breaks = seq(-ventana, ventana, by = 1)) +
scale_y_continuous(
name = "Número Total de Grants Activos",
sec.axis = sec_axis(~./coeff_grants, name = "Número de Autores (Línea Negra)")
) +
labs(
title = "Volumen de Grants NIH alrededor de la Retracción",
subtitle = "Ventana de ±3 años.",
x = "Años relativos a la Retracción (0)",
fill = "Período"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
print(plot_grants)
# ------------------------------------------------------------------------------
# 6. ANÁLISIS ESTADÍSTICO Y PORCENTAJES DE CAMBIO (BLOQUES DE 3 AÑOS)
# ------------------------------------------------------------------------------
df_comparacion <- df_ventana %>%
filter(diff_retracted != 0) %>%
mutate(
Bloque = ifelse(diff_retracted < 0, "1_Previo (-3 a -1)", "2_Posterior (1 a 3)")
) %>%
group_by(Bloque) %>%
summarise(
Autores_Unicos = n_distinct(Original_Author_Name),
Financiacion_Total = sum(Funding_Amount, na.rm = TRUE),
Total_Grants = n_distinct(Grant_ID),
# Calculamos la media anual por autor para el trienio
Media_Anual_Dinero_Por_Autor = (sum(Funding_Amount, na.rm = TRUE) / 3) / n_distinct(Original_Author_Name)
)
# Extraer variables para reporte
dinero_total_antes <- df_comparacion$Financiacion_Total[1]
dinero_total_despues <- df_comparacion$Financiacion_Total[2]
m_antes <- df_comparacion$Media_Anual_Dinero_Por_Autor[1]
m_despues <- df_comparacion$Media_Anual_Dinero_Por_Autor[2]
a_antes <- df_comparacion$Autores_Unicos[1]
a_despues <- df_comparacion$Autores_Unicos[2]
# Imprimir el reporte final en consola
cat("\n========================================================\n")
cat("📊 REPORTE DE IMPACTO INMEDIATO (VENTANA 3 AÑOS)\n")
cat("========================================================\n")
if(!is.na(dinero_total_antes) && dinero_total_antes > 0) {
caida_total_pct <- ((dinero_total_antes - dinero_total_despues) / dinero_total_antes) * 100
caida_media_pct <- ((m_antes - m_despues) / m_antes) * 100
caida_autores_pct <- ((a_antes - a_despues) / a_antes) * 100
cat(sprintf("📉 1. CAÍDA BRUTA: El volumen total de dólares financiados cayó un %.2f%%.\n", caida_total_pct))
cat(sprintf("📉 2. PENALIZACIÓN INDIVIDUAL: La media anual por autor cambió un %.2f%%.\n", caida_media_pct))
cat(sprintf("🏃‍♂️ 3. ABANDONO: El número de autores financiados cayó de %d a %d (%.2f%%).\n", a_antes, a_despues, caida_autores_pct))
cat("========================================================\n")
} else {
cat("[!] No hay suficientes datos para calcular los porcentajes.\n")
}
library(tidyverse)
library(scales)
library(quantmod)
library(lubridate)
install.packages("quantmod")
library(tidyverse)
library(scales)
library(quantmod)
library(lubridate)
# ------------------------------------------------------------------------------
# 1. DESCARGAR INFLACIÓN OFICIAL (EEUU) Y CREAR DEFLACTOR
# ------------------------------------------------------------------------------
cat("Descargando datos históricos de inflación (CPI) desde la Reserva Federal...\n")
getSymbols("CPIAUCSL", src='FRED') # Índice de precios al consumidor EEUU
df_cpi <- data.frame(Date = index(CPIAUCSL), CPI = coredata(CPIAUCSL))
colnames(df_cpi) <- c("Date", "CPI")
cpi_anual <- df_cpi %>%
mutate(Fiscal_Year = year(Date)) %>%
group_by(Fiscal_Year) %>%
summarise(CPI = mean(CPI, na.rm = TRUE))
cpi_actual <- max(cpi_anual$CPI, na.rm = TRUE)
cpi_anual <- cpi_anual %>%
mutate(Inflacion_Multiplicador = cpi_actual / CPI)
# ------------------------------------------------------------------------------
# 2. CARGAR DATOS, DESDUPLICAR (AÑO CERO) Y AJUSTAR INFLACIÓN
# ------------------------------------------------------------------------------
ruta_archivo <- "data/processed/Author_Funding_Matches.csv"
df_raw <- read_csv(ruta_archivo, show_col_types = FALSE)
df <- df_raw %>%
group_by(Original_Author_Name) %>%
mutate(Primer_Año_Retraccion = min(Retraction_Year, na.rm = TRUE)) %>%
ungroup() %>%
mutate(diff_retracted = Fiscal_Year - Primer_Año_Retraccion) %>%
# Desduplicar para no sumar grants repetidos de autores reincidentes
distinct(Original_Author_Name, Grant_ID, Fiscal_Year, Funding_Amount, diff_retracted) %>%
# Unir con tabla de inflación
left_join(cpi_anual, by = "Fiscal_Year") %>%
mutate(Funding_Adjusted = Funding_Amount * Inflacion_Multiplicador)
# ------------------------------------------------------------------------------
# 3. DEFINIR LA VENTANA TEMPORAL (Ej: 3 años)
# ------------------------------------------------------------------------------
ventana <- 3
df_ventana <- df %>%
filter(diff_retracted >= -ventana & diff_retracted <= ventana)
# ------------------------------------------------------------------------------
# 4. PREPARACIÓN DE DATOS (CON CONTROL DE SUPERVIVENCIA)
# ------------------------------------------------------------------------------
df_timeline <- df_ventana %>%
group_by(diff_retracted) %>%
summarise(
Dinero_Total_Ajustado = sum(Funding_Adjusted, na.rm = TRUE),
Num_Grants = n_distinct(Grant_ID),
Num_Autores = n_distinct(Original_Author_Name),
Dinero_Medio_Por_Autor = Dinero_Total_Ajustado / Num_Autores
) %>%
mutate(
Etapa = case_when(
diff_retracted < 0 ~ "Antes (-3 a -1)",
diff_retracted == 0 ~ "Año Retracción (0)",
diff_retracted > 0 ~ "Después (1 a 3)"
)
) %>%
mutate(Etapa = factor(Etapa, levels = c("Antes (-3 a -1)", "Año Retracción (0)", "Después (1 a 3)")))
# ------------------------------------------------------------------------------
# 5. PLOT 1: DINERO PROMEDIO (AJUSTADO) Y LÍNEA DE SUPERVIVENCIA
# ------------------------------------------------------------------------------
coeff_dinero <- max(df_timeline$Dinero_Medio_Por_Autor, na.rm = TRUE) / max(df_timeline$Num_Autores, na.rm = TRUE)
plot_dinero <- ggplot(df_timeline, aes(x = diff_retracted)) +
geom_col(aes(y = Dinero_Medio_Por_Autor, fill = Etapa), color = "black", alpha = 0.85) +
geom_line(aes(y = Num_Autores * coeff_dinero), color = "black", linewidth = 1.2, group = 1) +
geom_point(aes(y = Num_Autores * coeff_dinero), color = "black", size = 3) +
geom_vline(xintercept = 0, linetype = "dashed", color = "black", linewidth = 1) +
scale_fill_manual(values = c("Antes (-3 a -1)" = "#2c7fb8",
"Año Retracción (0)" = "#bdbdbd",
"Después (1 a 3)" = "#de2d26")) +
scale_x_continuous(breaks = seq(-ventana, ventana, by = 1)) +
scale_y_continuous(
labels = label_dollar(),
name = "Dinero Constante Promedio (USD Actuales)",
sec.axis = sec_axis(~./coeff_dinero, name = "Número de Autores Activos (Línea Negra)")
) +
labs(
title = "Financiación Media del NIH y Supervivencia de los Autores",
subtitle = sprintf("Ajustado a inflación. Ventana de ±%d años.", ventana),
x = "Años relativos a la Retracción (0)",
fill = "Período"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
print(plot_dinero)
# ------------------------------------------------------------------------------
# 3. DEFINIR LA VENTANA TEMPORAL (Ej: 3 años)
# ------------------------------------------------------------------------------
ventana <- 5
df_ventana <- df %>%
filter(diff_retracted >= -ventana & diff_retracted <= ventana)
# ------------------------------------------------------------------------------
# 4. PREPARACIÓN DE DATOS (CON CONTROL DE SUPERVIVENCIA)
# ------------------------------------------------------------------------------
df_timeline <- df_ventana %>%
group_by(diff_retracted) %>%
summarise(
Dinero_Total_Ajustado = sum(Funding_Adjusted, na.rm = TRUE),
Num_Grants = n_distinct(Grant_ID),
Num_Autores = n_distinct(Original_Author_Name),
Dinero_Medio_Por_Autor = Dinero_Total_Ajustado / Num_Autores
) %>%
mutate(
Etapa = case_when(
diff_retracted < 0 ~ "Antes (-3 a -1)",
diff_retracted == 0 ~ "Año Retracción (0)",
diff_retracted > 0 ~ "Después (1 a 3)"
)
) %>%
mutate(Etapa = factor(Etapa, levels = c("Antes (-3 a -1)", "Año Retracción (0)", "Después (1 a 3)")))
# ------------------------------------------------------------------------------
# 5. PLOT 1: DINERO PROMEDIO (AJUSTADO) Y LÍNEA DE SUPERVIVENCIA
# ------------------------------------------------------------------------------
coeff_dinero <- max(df_timeline$Dinero_Medio_Por_Autor, na.rm = TRUE) / max(df_timeline$Num_Autores, na.rm = TRUE)
plot_dinero <- ggplot(df_timeline, aes(x = diff_retracted)) +
geom_col(aes(y = Dinero_Medio_Por_Autor, fill = Etapa), color = "black", alpha = 0.85) +
geom_line(aes(y = Num_Autores * coeff_dinero), color = "black", linewidth = 1.2, group = 1) +
geom_point(aes(y = Num_Autores * coeff_dinero), color = "black", size = 3) +
geom_vline(xintercept = 0, linetype = "dashed", color = "black", linewidth = 1) +
scale_fill_manual(values = c("Antes (-3 a -1)" = "#2c7fb8",
"Año Retracción (0)" = "#bdbdbd",
"Después (1 a 3)" = "#de2d26")) +
scale_x_continuous(breaks = seq(-ventana, ventana, by = 1)) +
scale_y_continuous(
labels = label_dollar(),
name = "Dinero Constante Promedio (USD Actuales)",
sec.axis = sec_axis(~./coeff_dinero, name = "Número de Autores Activos (Línea Negra)")
) +
labs(
title = "Financiación Media del NIH y Supervivencia de los Autores",
subtitle = sprintf("Ajustado a inflación. Ventana de ±%d años.", ventana),
x = "Años relativos a la Retracción (0)",
fill = "Período"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
print(plot_dinero)
# ------------------------------------------------------------------------------
# 6. PLOT 2: NÚMERO TOTAL DE GRANTS ACTIVOS
# ------------------------------------------------------------------------------
coeff_grants <- max(df_timeline$Num_Grants, na.rm = TRUE) / max(df_timeline$Num_Autores, na.rm = TRUE)
plot_grants <- ggplot(df_timeline, aes(x = diff_retracted)) +
geom_col(aes(y = Num_Grants, fill = Etapa), color = "black", alpha = 0.85) +
geom_line(aes(y = Num_Autores * coeff_grants), color = "black", linewidth = 1.2, group = 1) +
geom_point(aes(y = Num_Autores * coeff_grants), color = "black", size = 3) +
geom_vline(xintercept = 0, linetype = "dashed", color = "black", linewidth = 1) +
scale_fill_manual(values = c("Antes (-3 a -1)" = "#2c7fb8",
"Año Retracción (0)" = "#bdbdbd",
"Después (1 a 3)" = "#de2d26")) +
scale_x_continuous(breaks = seq(-ventana, ventana, by = 1)) +
scale_y_continuous(
name = "Número Total de Grants Activos",
sec.axis = sec_axis(~./coeff_grants, name = "Número de Autores Activos (Línea Negra)")
) +
labs(
title = "Volumen de Grants NIH concedidos",
subtitle = sprintf("Ventana de ±%d años.", ventana),
x = "Años relativos a la Retracción (0)",
fill = "Período"
) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom")
print(plot_grants)
# ------------------------------------------------------------------------------
# 7. ANÁLISIS ESTADÍSTICO (RESUMEN PRE VS POST)
# ------------------------------------------------------------------------------
df_comparacion <- df_ventana %>%
filter(diff_retracted != 0) %>%
mutate(Bloque = ifelse(diff_retracted < 0, "1_Previo", "2_Posterior")) %>%
group_by(Bloque) %>%
summarise(
Autores_Unicos = n_distinct(Original_Author_Name),
Financiacion_Total_Ajustada = sum(Funding_Adjusted, na.rm = TRUE),
Total_Grants = n_distinct(Grant_ID),
Media_Anual_Dinero_Por_Autor = (sum(Funding_Adjusted, na.rm = TRUE) / ventana) / n_distinct(Original_Author_Name)
)
cat("\n========================================================\n")
cat(sprintf("📊 REPORTE DE IMPACTO (VENTANA %d AÑOS - AJUSTADO A INFLACIÓN)\n", ventana))
cat("========================================================\n")
if(nrow(df_comparacion) == 2) {
dinero_total_antes <- df_comparacion$Financiacion_Total_Ajustada[1]
dinero_total_despues <- df_comparacion$Financiacion_Total_Ajustada[2]
m_antes <- df_comparacion$Media_Anual_Dinero_Por_Autor[1]
m_despues <- df_comparacion$Media_Anual_Dinero_Por_Autor[2]
a_antes <- df_comparacion$Autores_Unicos[1]
a_despues <- df_comparacion$Autores_Unicos[2]
caida_total_pct <- ((dinero_total_antes - dinero_total_despues) / dinero_total_antes) * 100
caida_media_pct <- ((m_antes - m_despues) / m_antes) * 100
caida_autores_pct <- ((a_antes - a_despues) / a_antes) * 100
cat(sprintf("💰 1. CAÍDA BRUTA: El volumen total de dinero (en $ constantes) cayó un %.2f%%.\n", caida_total_pct))
cat(sprintf("📉 2. PENALIZACIÓN INDIVIDUAL: El poder adquisitivo medio anual por autor cambió un %.2f%%.\n", caida_media_pct))
cat(sprintf("🏃‍♂️ 3. ABANDONO: El número de autores financiados cayó de %d a %d (%.2f%%).\n", a_antes, a_despues, caida_autores_pct))
cat("========================================================\n")
}
